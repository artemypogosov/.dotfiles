#!/bin/bash

# Laptop
if [ -d /sys/class/power_supply/BAT0 ] || [ -d /sys/class/power_supply/BAT1 ]; then
  INTERNAL=$(xrandr | grep -E "^eDP|^LVDS" | cut -d' ' -f1)
  EXTERNAL=$(xrandr | grep " connected" | grep -v "^eDP" | cut -d' ' -f1)

  if [ -n "$EXTERNAL" ]; then
    xrandr --output "$INTERNAL" --auto --primary
    xrandr --output "$EXTERNAL" --auto --right-of "$INTERNAL"
  else
    xrandr --output "$INTERNAL" --auto --primary
  fi
else
  # Desktop
  # Because monitors are always named without spaces
  # shellcheck disable=SC2207
  MONITORS=($(xrandr | grep " connected" | cut -d' ' -f1))

  if [ ${#MONITORS[@]} -ge 2 ]; then
    xrandr --output "${MONITORS[0]}" --auto --primary
    xrandr --output "${MONITORS[1]}" --auto --right-of "${MONITORS[0]}"
  else
    xrandr --output "${MONITORS[0]}" --auto --primary
  fi
fi

# Відновлюємо шпалери
nitrogen --restore
